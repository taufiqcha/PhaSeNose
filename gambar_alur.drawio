        <mxCell id="panas" value="&lt;b&gt;Repeated heating&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5a6580&quot;&gt;5 min at 200 °C&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5a6580&quot;&gt;once per hour&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5a6580&quot;&gt;0–60 h&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;absoluteArcSize=1;arcSize=8;shadow=0;strokeWidth=1;fontFamily=Arial;fontSize=13;fontColor=#2d3142;align=center;verticalAlign=middle;spacing=8;strokeColor=#2d3142;fillColor=#ffffff;fillOpacity=100;" vertex="1" parent="1">
