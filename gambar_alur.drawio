        <mxCell id="minyak" value="&lt;b&gt;Palm cooking oil&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5a6580&quot;&gt;SA premium&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5a6580&quot;&gt;SIP economy&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;absoluteArcSize=1;arcSize=8;shadow=0;strokeWidth=1;fontFamily=Arial;fontSize=13;fontColor=#2d3142;align=center;verticalAlign=middle;spacing=8;strokeColor=#4f5d75;fillColor=#4f5d75;fillOpacity=10;" vertex="1" parent="1">
