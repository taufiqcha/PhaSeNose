    given-names: "Taufiq Choirul"
    affiliation: "Department of Informatics, Institut Teknologi Sepuluh Nopember"
    orcid: "https://orcid.org/0009-0006-2474-6650"
keywords:
  - Cooking oil quality
  - Electronic nose
  - GC–MS
  - Grouped cross-validation
  - Metal oxide sensors
  - Palm oil
  - Sensor drift
